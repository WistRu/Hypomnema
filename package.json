{
  "name": "tabhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tabhub/web build && pnpm --filter @tabhub/server dev",
    "dev:web": "pnpm --parallel --filter @tabhub/server --filter @tabhub/web dev",
    "dev:extension": "pnpm --filter @tabhub/extension dev",
    "start": "pnpm --filter @tabhub/server start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "backup": "pnpm --filter @tabhub/server backup",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "jsdom": "27.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
