{
  "name": "@tabhub/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --target node22 --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build",
    "test": "node -e \"require('fs').rmSync('.vitest-report.json',{force:true})\" && vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json --maxWorkers=4 && node ../../scripts/check-test-completeness.mjs . test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@tabhub/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
