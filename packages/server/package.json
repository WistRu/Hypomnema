{
  "name": "@tabhub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-foreground-helper.mjs && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --clean && node scripts/build-foreground-helper.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('.vitest-report.json',{force:true})\" && vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json --maxWorkers=2 && node ../../scripts/check-test-completeness.mjs . test",
    "backup": "tsx src/backup.ts",
    "baseline:g0": "tsx src/baseline-cli.ts",
    "baseline:g3": "tsx src/baseline-g3-cli.ts",
    "baseline:g6": "tsx src/baseline-g6-cli.ts",
    "baseline:g8": "tsx src/baseline-g8-cli.ts",
    "availability": "tsx src/availability-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@tabhub/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "ipaddr.js": "2.5.0",
    "parse5": "8.0.1",
    "sqlite-vec": "0.1.9",
    "tldts": "7.4.10"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
