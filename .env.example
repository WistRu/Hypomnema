TABHUB_HOST=127.0.0.1
TABHUB_PORT=7717
TABHUB_DB_PATH=./data/tabhub.sqlite
TABHUB_FEATURE_LOGICAL_IMPORTANCE=false
TABHUB_FEATURE_CONTEXT=false
TABHUB_FEATURE_PAGE_SUMMARY_CAPTURE=false
TABHUB_FEATURE_RESOURCES=false
TABHUB_FEATURE_ACTIVITY_WINDOWS=false
TABHUB_FEATURE_ACTIVITY_DAILY_WRITER=false
TABHUB_FEATURE_PRIORITY_ASSESSMENT_WRITER=false
TABHUB_FEATURE_PRIORITY_READERS=false
TABHUB_FEATURE_PRIORITY_SHADOW=false
TABHUB_FEATURE_RESEARCH=false
TABHUB_FEATURE_LIVE_ACQUISITION=false
TABHUB_FEATURE_PRIVACY_PURGE=false
# Server-only secret injected by the Vite dev proxy into the local-session bootstrap.
# Never expose this through a VITE_ environment variable or browser bundle.
TABHUB_DEV_PROXY_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_SHORT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DEEP_MODEL=claude-sonnet-5
ANTHROPIC_SHORT_INPUT_USD_PER_MTOK=
ANTHROPIC_SHORT_OUTPUT_USD_PER_MTOK=
ANTHROPIC_DEEP_INPUT_USD_PER_MTOK=
ANTHROPIC_DEEP_OUTPUT_USD_PER_MTOK=
ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5
# Optional explicit immutable label; when blank, startup derives one from the effective prices.
ANTHROPIC_RESEARCH_PRICING_VERSION=
ANTHROPIC_RESEARCH_INPUT_USD_PER_MTOK=
ANTHROPIC_RESEARCH_OUTPUT_USD_PER_MTOK=
TABHUB_SUMMARY_MAX_INPUT_CHARS=200000
TABHUB_SUMMARY_TIMEOUT_MS=120000
TABHUB_SUMMARY_MAX_ATTEMPTS=5
TABHUB_SUMMARY_POLL_MS=1000
TABHUB_DAILY_SUMMARY_LIMIT=100
TABHUB_RESEARCH_MAX_OUTPUT_TOKENS=8192
TABHUB_RESEARCH_TIMEOUT_MS=120000
TABHUB_LIVE_ACQUISITION_MAX_ATTEMPTS_PER_UTC_DAY=20
EMBEDDING_PROVIDER=ollama
TABHUB_EMBEDDING_TIMEOUT_MS=120000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
