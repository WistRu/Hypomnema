# C98 rollback profile for the personal attention layer.
#
# Rollback means running the SAME build as the Trial week with every personal
# attention flag off, on the SAME schema 26 database. No user row is rolled back.
# Restoring a backup is a different, destructive path and needs the user's own
# explicit instruction: see docs/personal-attention-layer-rollback-recipe.md.
#
# This file is hashed and the hash is recorded in the C98 receipt. Change it and the
# receipt stops matching, which is the point.
TABHUB_HOST=127.0.0.1
TABHUB_PORT=7717
TABHUB_DB_PATH=./data/tabhub.sqlite

TABHUB_FEATURE_CONTEXT=false
TABHUB_FEATURE_RESOURCES=false
TABHUB_FEATURE_ACTIVITY_WINDOWS=false
TABHUB_FEATURE_ACTIVITY_DAILY_WRITER=false
TABHUB_FEATURE_LOGICAL_IMPORTANCE=false
TABHUB_FEATURE_PRIORITY_READERS=false
TABHUB_FEATURE_PRIORITY_SHADOW=false
TABHUB_FEATURE_PRIORITY_PERSONALIZATION=false
TABHUB_FEATURE_RESEARCH=false
TABHUB_FEATURE_LIVE_ACQUISITION=false
TABHUB_FEATURE_PRIVACY_PURGE=false
TABHUB_FEATURE_PAGE_SUMMARY_CAPTURE=false
TABHUB_FEATURE_PRIORITY_ASSESSMENT_WRITER=false
